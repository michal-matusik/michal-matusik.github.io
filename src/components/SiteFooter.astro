---
import { site } from '../config/site';

interface Props {
  showRSS?: boolean;
}

const showRSS = Astro.props.showRSS ?? false;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__row">
    <p>&copy; {year} {site.name}</p>
    <ul class="site-footer__links">
      <li><a href={site.links.github}>GitHub</a></li>
      {site.links.linkedin && <li><a href={site.links.linkedin}>LinkedIn</a></li>}
      {showRSS && <li><a href="/rss.xml">RSS</a></li>}
    </ul>
  </div>
</footer>
