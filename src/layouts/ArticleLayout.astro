---
import BaseLayout from './BaseLayout.astro';
import { site } from '../config/site';
import { getSiteVisibility } from '../lib/site-state';
import type { CollectionEntry } from 'astro:content';

type Props = CollectionEntry<'writing'>['data'] & { id: string };

const { title, description, published, updated, tags, canonicalUrl, ogImage, id } = Astro.props;
const { showWriting, showRSS } = await getSiteVisibility();

const dateLabel = published.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const showUpdated = updated && updated.getTime() > published.getTime();
const canonicalURL = canonicalUrl ?? new URL(`/writing/${id}/`, site.url).toString();
---

<BaseLayout
  title={`${title} — ${site.name}`}
  description={description}
  image={ogImage}
  type="article"
  showWriting={showWriting}
  showRSS={showRSS}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      datePublished: published.toISOString(),
      dateModified: (updated ?? published).toISOString(),
      author: { '@type': 'Person', name: site.name },
      mainEntityOfPage: canonicalURL,
    })}
  />
  <article class="container prose-width">
    <p><a href="/writing/">&larr; Back to Writing</a></p>
    <h1>{title}</h1>
    <p class="hero__role">
      {dateLabel}
      {showUpdated && ` · Updated ${updated!.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}`}
    </p>
    <ul class="tag-list">
      {tags.map((tag) => <li class="tag">{tag}</li>)}
    </ul>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
