---
import BaseLayout from './BaseLayout.astro';
import { site } from '../config/site';
import { getSiteVisibility } from '../lib/site-state';
import type { CollectionEntry } from 'astro:content';

type Props = CollectionEntry<'projects'>['data'] & { id: string };

const { title, subtitle, summary, role, startDate, endDate, stack, links } = Astro.props;
const { showWriting, showRSS } = await getSiteVisibility();

const dateFormat: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'short', timeZone: 'UTC' };
const dateRange = endDate
  ? `${startDate.toLocaleDateString('en-US', dateFormat)} – ${endDate.toLocaleDateString('en-US', dateFormat)}`
  : `Since ${startDate.toLocaleDateString('en-US', dateFormat)}`;
---

<BaseLayout
  title={`${title} — ${site.name}`}
  description={summary}
  type="article"
  showWriting={showWriting}
  showRSS={showRSS}
>
  <article class="container prose-width">
    <p><a href="/projects/">&larr; Back to Projects</a></p>
    <h1>{title}</h1>
    {subtitle && <p class="hero__value">{subtitle}</p>}
    <p class="hero__role">
      {role} · {dateRange}
    </p>
    <ul class="tag-list">
      {stack.map((tech) => <li class="tag">{tech}</li>)}
    </ul>
    <p class="hero__links">
      {links.source && <a class="button" href={links.source}>Source</a>}
      {links.demo && <a class="button" href={links.demo}>Demo</a>}
      {links.paper && <a class="button" href={links.paper}>Paper</a>}
    </p>
    {/* Screenshot/demo media and a limitations-and-next-steps section are pending owner-supplied assets. */}
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
