---
import BaseHead from '../components/BaseHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../config/site';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/components.css';
import '../styles/prose.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  showWriting?: boolean;
  personJsonLd?: boolean;
}

const { title, description, image, type, showWriting, personJsonLd = false } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} type={type} />
    {
      personJsonLd && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify({
            '@context': 'https://schema.org',
            '@type': 'Person',
            name: site.name,
            url: site.url,
            jobTitle: site.role,
            sameAs: [site.links.github, site.links.linkedin].filter(Boolean),
          })}
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader showWriting={showWriting} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
