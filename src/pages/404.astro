---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
import { getSiteVisibility } from '../lib/site-state';

const { showWriting, showRSS } = await getSiteVisibility();
---

<BaseLayout
  title={`Page not found — ${site.name}`}
  description="This page could not be found."
  showWriting={showWriting}
  showRSS={showRSS}
>
  <section class="container section prose-width">
    <h1>Page not found</h1>
    <p>The page you're looking for doesn't exist or has moved.</p>
    <div class="hero__links">
      <a class="button button--primary" href="/">Home</a>
      <a class="button" href="/projects/">Projects</a>
      {showWriting && <a class="button" href="/writing/">Writing</a>}
    </div>
  </section>
</BaseLayout>
