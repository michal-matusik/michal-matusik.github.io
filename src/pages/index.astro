---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import WritingCard from '../components/WritingCard.astro';
import { getCollection } from 'astro:content';
import { site } from '../config/site';
import { getSiteVisibility } from '../lib/site-state';

const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const featuredProjects = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order || a.data.startDate.getTime() - b.data.startDate.getTime())
  .slice(0, 3);

const { showWriting, showRSS } = await getSiteVisibility();
const allPosts = await getCollection('writing', ({ data }) => !data.draft);
const featuredPosts = allPosts
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.published.getTime() - a.data.published.getTime())
  .slice(0, 3);
---

<BaseLayout
  title={`${site.name} — ML/AI Software Engineer`}
  description={site.description}
  personJsonLd
  showWriting={showWriting}
  showRSS={showRSS}
>
  <section class="container hero" id="top">
    <img class="hero__portrait" src="/portrait.jpg" alt={site.name} width="144" height="144" />
    <div class="hero__content">
      <h1 class="hero__name">{site.name}</h1>
      <p class="hero__role">{site.role}</p>
      {/* Pending owner-authored copy per WEBSITE_IMPROVEMENT_PLAN.md Priority 2 */}
      <p class="hero__value">{site.positioning}</p>
      <div class="hero__links">
        <a class="button button--primary" href="/#work">View my work</a>
        <a class="button" href={site.links.resume}>Résumé</a>
        <a class="button" href={site.links.github}>GitHub</a>
        {site.links.linkedin && <a class="button" href={site.links.linkedin}>LinkedIn</a>}
        <a class="button" href={`mailto:${site.email}`}>Email</a>
      </div>
    </div>
  </section>

  <section class="container credibility">
    <span>B.S. Computer Science, Purdue University · Expected 2030</span>
  </section>

  <section class="container section" id="work">
    <div class="section__heading">
      <h2>Selected work</h2>
      <a class="section__link" href="/projects/">View all projects &rarr;</a>
    </div>
    {
      featuredProjects.length > 0 ? (
        <div class="card-grid">
          {featuredProjects.map((project) => <ProjectCard project={project} />)}
        </div>
      ) : (
        <p class="hero__role">Add featured projects to src/content/projects to populate this section.</p>
      )
    }
  </section>

  <section class="container section" id="education">
    <div class="section__heading">
      <h2>Education</h2>
    </div>
    <p><strong>Purdue University</strong></p>
    <p class="hero__role">B.S. Computer Science · Expected 2030</p>
  </section>

  {
    showWriting && (
      <section class="container section" id="writing">
        <div class="section__heading">
          <h2>Writing</h2>
          <a class="section__link" href="/writing/">
            View all writing &rarr;
          </a>
        </div>
        <div class="card-grid">
          {featuredPosts.map((post) => <WritingCard post={post} />)}
        </div>
      </section>
    )
  }

  <section class="container section prose-width" id="about">
    <div class="section__heading">
      <h2>About</h2>
    </div>
    {/* Pending owner-authored copy per WEBSITE_IMPROVEMENT_PLAN.md About section */}
    <p>
      I'm a Computer Science freshman at Purdue University, originally from Poland, with a
      strong interest in mathematics and artificial intelligence. I'm especially drawn to
      problems where algorithms can move beyond benchmarks and become genuinely useful tools.
    </p>
    <p>
      I enjoy turning mathematical ideas into practical projects and digging deeper into how
      models work, where they fail, and how they can be improved. Outside of coding, I run
      and swim—my favorite ways to reset and recharge.
    </p>
    <p>
      My goal is simple: <strong>build the future with AI, not just watch it arrive.</strong>
    </p>
  </section>

  <section class="container section" id="contact">
    <div class="section__heading">
      <h2>Contact</h2>
    </div>
    <p>
      Reach out at <a href={`mailto:${site.email}`}>{site.email}</a>.
    </p>
  </section>
</BaseLayout>
